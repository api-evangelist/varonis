      "name": "Events",
      "description": {
        "content": "Access forensic event data associated with specific alerts for investigation and threat hunting.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "df1b4d78-d25b-4282-b84b-07f4733e8fc5",
          "name": "Varonis Get Alerted Events",
          "request": {
            "name": "Varonis Get Alerted Events",
            "description": {
              "content": "Retrieves the underlying events associated with a specific alert for forensic investigation. Returns event-level data including operation types, source and destination accounts, affected resources, IP addresses, and geolocation information. Essential for threat hunting and understanding the full scope of a security incident.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "threatdetection",
                "api",
                "alert",
                "alert",
                "GetAlertedEvents"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The domain of your Varonis SaaS instance, typically in the format your-instance.varonis.io.",
                  "type": "any",
                  "value": "{{domain}}",
                  "key": "domain"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alertId\": \"<string>\",\n  \"startTime\": \"<dateTime>\",\n  \"endTime\": \"<dateTime>\",\n  \"lastDays\": \"<integer>\",\n  \"extraFields\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"descendingOrder\": \"<boolean>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
